<Project Sdk="Microsoft.NET.Sdk">

  <!-- ARCH-002 acceptance tests: Kit.fs, then every file in Acceptance/ (the harness copies a
       task's visible tests there). Not part of Summa at 8b0e93e; added by the fixture. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Kit.fs" />
    <Compile Include="Acceptance/*.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Summa.Web.Application/Summa.Web.Application.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
