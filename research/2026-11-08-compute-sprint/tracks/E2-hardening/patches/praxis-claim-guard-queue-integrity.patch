+    /// EXPERIMENTAL (E2 / E-F-03): the local claim store lives in the Git
+    /// directory, so a completing process can delete it. The tracked event
+    /// log records a token-free `work.claim.recorded` marker for every claim
+    /// and the canonical `work.completion.verified` event, so "claimed" is
+    /// derived from the tracked history as well as the store: a store that
+    /// is missing (or claims completion) while the tracked history shows a
+    /// claim without a verified completion is refused, never trusted.
+    let ClaimRecordMissingCode = "PRX.COMPLETION.CLAIM_RECORD_MISSING"
+
+    let decideWithHistory (requireVerified: bool) (workItemId: string) (claim: WorkClaim option) (history: TrackedClaimHistory) =
+        match claim, history with
+        | None, TrackedClaimHistory.Claimed ->
+            PlainCompletion.Refused
+                { Code = ClaimRecordMissingCode
+                  Detail =
+                    $"the tracked event log records a claim on work item '{workItemId}' but the claim store has no record of it; "
+                    + "the claim store is not a trust root, so plain 'work complete' is refused (complete it with 'praxis work complete-verified')" }
+        | Some claim, TrackedClaimHistory.Claimed when claim.Status = ClaimStatus.Completed ->
+            PlainCompletion.Refused
+                { Code = ClaimRecordMissingCode
+                  Detail =
+                    $"the claim store marks work item '{workItemId}' completed but the tracked event log has no 'work.completion.verified' event for it" }
+        | None, TrackedClaimHistory.VerifiedComplete -> PlainCompletion.Permitted
+        | _ -> decide requireVerified workItemId claim
+
+    /// `decideAll` over the tracked history as well as the store.
+    let decideAllWithHistory (requireVerified: bool) (claims: (string * WorkClaim option * TrackedClaimHistory) list) =
+        claims
+        |> List.map (fun (id, claim, history) -> decideWithHistory requireVerified id claim history)
+        |> List.tryPick (function
+            | PlainCompletion.Refused finding -> Some(PlainCompletion.Refused finding)
+            | PlainCompletion.Permitted -> None)
+        |> Option.defaultValue PlainCompletion.Permitted
