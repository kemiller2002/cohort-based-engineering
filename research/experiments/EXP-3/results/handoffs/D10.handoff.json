      },
      "supersedes": []
    },
    {
      "id": "CLIN-22-R2",
      "statement": "Follow-up appointments may be booked up to 180 days ahead, so that patients can leave with their next visit booked. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged; `dotnet test Clinic.slnx` passes.",
      "status": "accepted",
      "owner": "Scheduling Office",
      "source": {
