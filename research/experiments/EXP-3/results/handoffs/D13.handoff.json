  "requirements": [
    {
      "id": "BILL-21-R1",
      "statement": "Invoices apply the customer discounts that DEC-B06 and DEC-B07 decide. The discount is taken off the amount given to `invoice`, and the invoice is issued for what remains. When a discount applies, `invoice` prints the amount, the discount and the amount invoiced: `i1 issued to c3: 100.00 - discount 5.00 = 95.00 due 2026-04-01`. When no discount applies, the output is unchanged.",
      "status": "accepted",
      "owner": "Finance",
      "source": {
        "path": "requirements/BILL-21.md",
        "locator": "## BILL-21-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
        "sha256": "sha256:c2b50bd9d21c17d0d32002cfb1c3f8f1c53fa3111e6c1a2d274f80c35ebf629f"
      },
      "supersedes": []
    },
    {
      "id": "BILL-21-R2",
      "statement": "`show`, balances and late fees use the amount invoiced, after the discount. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged except as these requirements say; `dotnet test Billing.slnx` passes.",
      "status": "accepted",
      "owner": "Finance",
      "source": {
        "path": "requirements/BILL-21.md",
        "locator": "## BILL-21-R2",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
