+/// What the tracked event log (`.ros/events/events.jsonl`, working tree and
+/// HEAD) says about one work item's claim history (EXPERIMENTAL, E2).
+[<RequireQualifiedAccess>]
+type TrackedClaimHistory =
+    | NeverClaimed
+    | Claimed
+    | VerifiedComplete
+
+[<RequireQualifiedAccess>]
+module TrackedClaimHistory =
+    let ClaimRecordedType = "work.claim.recorded"
+    let VerifiedType = "work.completion.verified"
+
+    /// Pure fold over the (type, workItem) pairs of the tracked log lines.
+    let ofEvents (workItemId: string) (events: (string * string) list) =
+        let types = events |> List.filter (fun (_, item) -> item = workItemId) |> List.map fst |> Set.ofList
+
+        if types.Contains VerifiedType then TrackedClaimHistory.VerifiedComplete
+        elif types.Contains ClaimRecordedType then TrackedClaimHistory.Claimed
+        else TrackedClaimHistory.NeverClaimed
+
