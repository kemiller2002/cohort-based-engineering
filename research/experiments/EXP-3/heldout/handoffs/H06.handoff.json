      },
      "supersedes": []
    },
    {
      "id": "PAY-22-R2",
      "statement": "Mileage is paid at the per-kilometre rate in force, rounded to the cent. Meal claims are paid up to the daily meal cap in force for each day claimed. Any other claim is paid at its receipted amount. Acceptance criteria: each statement above holds; existing behaviour is unchanged except as these requirements say.",
      "status": "accepted",
      "owner": "Finance Operations",
      "source": {
