      },
      "supersedes": []
    },
    {
      "id": "CLM-12-R2",
      "statement": "Each newly reported claim gets an acknowledgement deadline under the acknowledgement decision in force. The list flags every claim whose deadline has passed.",
      "status": "accepted",
      "owner": "Claims Operations; Special Investigations",
      "source": {
        "path": "requirements/CLM-12.md",
        "locator": "## CLM-12-R2",
