+    let private markerEntries = set [ " M .ros/events/events.jsonl"; "M  .ros/events/events.jsonl"; "?? .ros/events/events.jsonl"; "?? .ros/events/" ]
+
+    /// `git status --porcelain` entries (untracked files included), less a
+    /// tracked log that differs from HEAD only by claim markers.
     let worktreeStatus (root: string) () =
         match ClaimProcess.run "git" root [] None FileWorkClaims.gitTimeout [ "status"; "--porcelain=v1"; "-z" ] with
-        | Ok result when result.ExitCode = 0 -> Ok(result.Stdout.Split('\000', StringSplitOptions.RemoveEmptyEntries) |> Array.toList)
+        | Ok result when result.ExitCode = 0 ->
+            let entries = result.Stdout.Split('\000', StringSplitOptions.RemoveEmptyEntries) |> Array.toList
+            if entries |> List.exists markerEntries.Contains && claimMarkerOnly root then
+                Ok(entries |> List.filter (markerEntries.Contains >> not))
+            else
+                Ok entries
         | Ok result -> Error $"cannot inspect the worktree: {result.Stderr.Trim()}"
         | Error _ -> Error "cannot inspect the worktree: git is unavailable"
 
