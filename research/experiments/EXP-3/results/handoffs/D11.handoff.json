      },
      "supersedes": []
    },
    {
      "id": "CLIN-23-R2",
      "statement": "Before this change is released, Pharmacy verifies that the maximum doses the program uses match the formulary, and records that verification in `docs/verification/`. CLIN-23 is complete only when that verification is recorded. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged; `dotnet test Clinic.slnx` passes.",
      "status": "accepted",
      "owner": "Pharmacy",
      "source": {
