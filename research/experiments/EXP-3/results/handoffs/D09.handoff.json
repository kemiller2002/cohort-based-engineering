    },
    {
      "id": "CLIN-21-R3",
      "statement": "Urgent prescriptions must reach the patient without delay. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged; `dotnet test Clinic.slnx` passes.",
