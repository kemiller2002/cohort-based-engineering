  "requirements": [
    {
      "id": "CLM-12-R1",
      "statement": "A daily referral list shows each open claim that must go to Special Investigations under the referral decision in force, oldest report first, with the date its review is due.",
      "status": "accepted",
      "owner": "Claims Operations; Special Investigations",
      "source": {
        "path": "requirements/CLM-12.md",
        "locator": "## CLM-12-R1",
