  "requirements": [
    {
      "id": "BILL-15-R1",
      "statement": "An invoice that is still unpaid more than 30 days after its due date is charged a reminder fee of 5.00, in addition to its late fee. The reminder fee is charged once per invoice, when late fees are run, and then forms part of what is outstanding. `run-late-fees` reports both counts: `late fees applied: 1, reminder fees applied: 0`.",
      "status": "accepted",
      "owner": "Finance",
      "source": {
        "path": "requirements/BILL-15.md",
        "locator": "## BILL-15-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
