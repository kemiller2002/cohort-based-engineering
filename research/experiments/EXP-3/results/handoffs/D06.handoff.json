      },
      "supersedes": []
    },
    {
      "id": "BILL-13-R2",
      "statement": "The discounted amount is the invoice's amount everywhere: `show`, the balance and the late fee use it. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged except as these requirements say; `dotnet test Billing.slnx` passes.",
      "status": "accepted",
      "owner": "Finance",
      "source": {
        "path": "requirements/BILL-13.md",
        "locator": "## BILL-13-R2",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
