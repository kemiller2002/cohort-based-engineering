    "decisions": [
      {
        "id": "U7-D1",
        "statement": "The notice state is stored on the loan as Loan.Notice : OverdueNotice option, where OverdueNotice = { DueDate; SentOn; Delivery } and Delivery is NoticeDelivered | NoticeDeliveryUnknown | NoticeConfirmedDelivered (Tier 1). Because it lives on the loan, returning the copy removes it, and a later loan of the same copy, even one made on the same day, starts with no notice (R3). Rejected notices and notices confirmed as not delivered are not stored (Notice = None), so \u0027needs a notice\u0027 cannot be confused with \u0027blocked\u0027.",
        "basis": "assumption",
        "layer1": "recorded-assumption",
