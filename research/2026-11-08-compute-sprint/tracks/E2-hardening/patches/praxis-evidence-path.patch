diff --git a/src/Praxis.Domain/Work/Plan.fs b/src/Praxis.Domain/Work/Plan.fs
index e8dbe74..3ab0dd3 100644
--- a/src/Praxis.Domain/Work/Plan.fs
+++ b/src/Praxis.Domain/Work/Plan.fs
@@ -4,6 +4,30 @@ type WorkEvidence =
     { Type: string
       Path: string }
 
+/// EXPERIMENTAL (E2 / E-F-01): plain `work complete` evidence must resolve
+/// inside the repository root unless `workProtocol.allowExternalEvidence` is
+/// set. Paths are compared after `..` normalisation and symlink resolution
+/// (done by the caller), so `/etc/hostname`, `../../etc/hostname` and an
+/// in-repo link to it are all outside.
+[<RequireQualifiedAccess>]
+module EvidencePathPolicy =
+    let OutsideRepositoryCode = "PRX.EVIDENCE.OUTSIDE_REPOSITORY"
+
+    let contains (separator: char) (root: string) (resolved: string) =
+        let root = root.TrimEnd separator
+        resolved = root || resolved.StartsWith(root + string separator, System.StringComparison.Ordinal)
+
+    /// One refusal message per evidence entry whose resolved path is outside `root`.
+    let refusals (separator: char) (allowExternal: bool) (root: string) (resolved: (WorkEvidence * string) list) =
+        if allowExternal then
+            []
+        else
+            resolved
+            |> List.filter (fun (_, path) -> not (contains separator root path))
+            |> List.map (fun (evidence, path) ->
+                $"{OutsideRepositoryCode}: evidence '{evidence.Type}={evidence.Path}' resolves to '{path}', outside the repository root '{root}'; "
+                + "cite a file inside the repository (or opt out explicitly with workProtocol.allowExternalEvidence: true)")
+
 type LiveWorkItem =
     { Id: string
       WorkType: string
diff --git a/src/Praxis.Infrastructure/Work/FileEvidenceRepository.fs b/src/Praxis.Infrastructure/Work/FileEvidenceRepository.fs
index 5c64708..36367eb 100644
--- a/src/Praxis.Infrastructure/Work/FileEvidenceRepository.fs
+++ b/src/Praxis.Infrastructure/Work/FileEvidenceRepository.fs
@@ -2,6 +2,10 @@ namespace Praxis.Infrastructure.Work
 
 open System
 open System.IO
+open System.Security.Cryptography
+open System.Text
+open System.Text.Json
+open System.Text.Json.Nodes
 open Praxis.Application.Work
 open Praxis.Domain.Work
 
@@ -19,3 +23,101 @@ module FileEvidenceRepository =
 
     let create root : WorkEvidenceRepository =
         { Observe = observe (Path.GetFullPath root) }
+
+/// EXPERIMENTAL (E2 / E-F-01): repository containment and digest/commit
+/// binding for plain `work complete` evidence.
+[<RequireQualifiedAccess>]
+module FileEvidenceBinding =
+    let private bindingsRelativePath = ".ros/work/evidence-bindings.jsonl"
+
+    /// The absolute path with every symlinked component resolved.
+    let rec canonical (path: string) : string =
+        let full = Path.GetFullPath path
+        let parent = Path.GetDirectoryName full
+
+        if isNull parent then
+            full
+        else
+            let candidate = Path.Combine(canonical parent, Path.GetFileName full)
+
+            let target =
+                try
+                    let info = FileInfo candidate
+                    match info.LinkTarget with
+                    | null -> None
+                    | link ->
+                        match info.ResolveLinkTarget true with
+                        | null -> Some(Path.GetFullPath(Path.Combine(Path.GetDirectoryName candidate, link)))
+                        | resolved -> Some resolved.FullName
+                with _ -> None
+
+            match target with
+            | Some resolved when resolved <> candidate -> canonical resolved
+            | _ -> candidate
+
+    let private resolve root (evidence: WorkEvidence) =
+        canonical (if Path.IsPathRooted evidence.Path then evidence.Path else Path.Combine(root, evidence.Path))
+
+    /// `workProtocol.allowExternalEvidence` (default false: containment on).
+    let allowExternal (root: string) =
+        try
+            let path = Path.Combine(root, "ros.json")
+            if not (File.Exists path) then false
+            else
+                use document = JsonDocument.Parse(File.ReadAllText path)
+                match document.RootElement.TryGetProperty "workProtocol" with
+                | true, protocol when protocol.ValueKind = JsonValueKind.Object ->
+                    match protocol.TryGetProperty "allowExternalEvidence" with
+                    | true, value when value.ValueKind = JsonValueKind.True -> true
+                    | _ -> false
+                | _ -> false
+        with _ -> false
+
+    let refusals (root: string) (evidence: WorkEvidence list) =
+        let root = canonical root
+        EvidencePathPolicy.refusals Path.DirectorySeparatorChar (allowExternal root) root (evidence |> List.map (fun e -> e, resolve root e))
+
+    let private git (root: string) (arguments: string list) =
+        try
+            let info = Diagnostics.ProcessStartInfo("git", RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false, WorkingDirectory = root)
+            arguments |> List.iter info.ArgumentList.Add
+            use proc = Diagnostics.Process.Start info
+            let output = proc.StandardOutput.ReadToEnd()
+            proc.StandardError.ReadToEnd() |> ignore
+            if proc.WaitForExit 30000 && proc.ExitCode = 0 then Some(output.Trim()) else None
+        with _ -> None
+
+    let private bindingNode root (head: string option) (workItems: string list) (observedAt: string) (evidence: WorkEvidence) =
+        let resolved = resolve root evidence
+        let inside = EvidencePathPolicy.contains Path.DirectorySeparatorChar root resolved
+        let relative = if inside then Path.GetRelativePath(root, resolved).Replace('\\', '/') else resolved
+        let isFile = File.Exists resolved
+        let node = JsonObject()
+        node["schemaVersion"] <- JsonValue.Create "praxis.evidence-binding/1-experimental"
+        node["workItems"] <- JsonArray(workItems |> List.map (fun id -> JsonValue.Create id :> JsonNode) |> List.toArray)
+        node["type"] <- JsonValue.Create evidence.Type
+        node["path"] <- JsonValue.Create relative
+        node["insideRepository"] <- JsonValue.Create inside
+        node["sha256"] <- (if isFile then JsonValue.Create("sha256:" + Convert.ToHexString(SHA256.HashData(File.ReadAllBytes resolved)).ToLowerInvariant()) else null)
+        node["commit"] <- (match head with Some sha -> JsonValue.Create sha | None -> null)
+        node["committedAtHead"] <-
+            JsonValue.Create(
+                inside && isFile && head.IsSome
+                && (match git root [ "rev-parse"; $"HEAD:{relative}" ], git root [ "hash-object"; "--"; relative ] with
+                    | Some committed, Some current -> committed = current
+                    | _ -> false))
+        node["observedAt"] <- JsonValue.Create observedAt
+        node.ToJsonString()
+
+    /// Appends one binding line per evidence entry to `.ros/work/evidence-bindings.jsonl` (a Praxis-owned path the default path filter ignores).
+    let record (root: string) (workItems: string list) (evidence: WorkEvidence list) (observedAt: string) : Result<unit, string> =
+        try
+            let root = canonical root
+            let head = git root [ "rev-parse"; "--verify"; "HEAD^{commit}" ]
+            let lines = evidence |> List.map (bindingNode root head workItems observedAt)
+            let path = Path.Combine(root, bindingsRelativePath)
+            Directory.CreateDirectory(Path.GetDirectoryName path) |> ignore
+            File.AppendAllText(path, (lines |> List.map (fun line -> line + "\n") |> String.concat ""), UTF8Encoding(false))
+            Ok()
+        with error ->
+            Error $"evidence bindings could not be recorded: {error.Message}"
