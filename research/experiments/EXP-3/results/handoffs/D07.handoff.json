    {
      "id": "DEC-B02",
      "statement": "A customer's balance is what they owe: the sum of what is outstanding on their invoices. A balance never goes below zero. Money a customer is owed back (for example from a credit larger than their balance) is held as a refundable credit; only Finance releases a refundable credit, either as a refund or by applying it to a named invoice. A credit note is recorded against the customer, not against particular invoices.",
      "status": "accepted",
      "kind": "business-rule",
      "owner": "Finance",
      "authorizedBy": {
        "kind": "human",
        "id": "Finance",
        "role": "decision-owner"
      },
      "authorizedAt": "2026-01-05T00:00:00Z",
      "requirementIds": [],
      "source": {
