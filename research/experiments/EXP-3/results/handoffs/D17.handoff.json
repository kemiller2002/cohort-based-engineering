    {
      "id": "DEC-B02",
      "statement": "A customer's balance is what they owe: the sum of what is outstanding on their invoices. A balance never goes below zero. Money a customer is owed back (for example from a credit larger than their balance) is held as a refundable credit; only Finance releases a refundable credit, either as a refund or by applying it to a named invoice.",
      "status": "accepted",
      "kind": "business-rule",
      "owner": "Finance",
      "authorizedBy": {
        "kind": "human",
        "id": "Finance",
        "role": "decision-owner"
      },
      "authorizedAt": "2026-01-05T00:00:00Z",
      "requirementIds": [],
      "source": {
        "path": "docs/decisions/DEC-B02-balances.md",
        "locator": "# DEC-B02",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
        "sha256": "sha256:7ecd10cb2915e00af54f5b11777b01d84580d814c4570eae1a5576450e1c0f74"
      },
      "supersedes": []
    },
    {
      "id": "DEC-B03",
      "statement": "An invoice that is still unpaid after its due date is charged a late fee of 2% of the invoice amount, rounded to the cent (half away from zero). The fee is charged once per invoice, when late fees are run, and then forms part of what is outstanding on the invoice.",
      "status": "superseded",
      "kind": "business-rule",
      "owner": "Finance",
      "requirementIds": [],
      "source": {
