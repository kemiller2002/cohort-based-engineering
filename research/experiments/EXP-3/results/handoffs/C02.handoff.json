  "requirements": [
    {
      "id": "BILL-41-R1",
      "statement": "A new command `quote <customer> <amount>` tells a customer when an invoice for that amount, issued today, would have to be paid under the payment-terms decision in force: `quote c1 100.00 payable by 2026-03-23`. It issues nothing. An unknown customer prints `error: unknown customer c9`, and an amount that is not a positive amount of money prints `error: invalid amount x`.",
      "status": "accepted",
      "owner": "Sales Operations",
      "source": {
        "path": "requirements/BILL-41.md",
        "locator": "## BILL-41-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
        "sha256": "sha256:b94544eec4cb7485cc4a4bb7b28908eaf1667a9d6388e82f0b577b802838dc95"
      },
      "supersedes": []
    },
    {
      "id": "BILL-41-R2",
      "statement": "`help` lists `quote <customer> <amount>` directly after `invoice <invoice> <customer> <amount>`. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged except as these requirements say; `dotnet test Billing.slnx` passes.",
      "status": "accepted",
      "owner": "Sales Operations",
      "source": {
        "path": "requirements/BILL-41.md",
        "locator": "## BILL-41-R2",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
