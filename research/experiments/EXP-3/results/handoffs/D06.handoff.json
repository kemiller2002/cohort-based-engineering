    {
      "id": "BILL-13-R1",
      "statement": "Invoices apply the discounts that Finance has approved (`docs/approvals/`). `invoice` prints the discounted amount and the discount: `i1 issued to c2: 90.00 (discount 10.00) due 2026-04-01`. An invoice without a discount prints as before.",
      "status": "accepted",
      "owner": "Finance",
      "source": {
        "path": "requirements/BILL-13.md",
        "locator": "## BILL-13-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
