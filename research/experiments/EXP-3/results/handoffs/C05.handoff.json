  "requirements": [
    {
      "id": "BILL-43-R1",
      "statement": "A new command `run-interest` charges the collection interest that DEC-B14 decides on every invoice that owes it, and prints how many invoices were charged: `interest charged: 1`. Charged interest is part of what is outstanding on the invoice and of the customer's balance. `show` is unchanged.",
      "status": "accepted",
      "owner": "Credit Control",
      "source": {
        "path": "requirements/BILL-43.md",
        "locator": "## BILL-43-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
