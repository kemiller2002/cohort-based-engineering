  "requirements": [
    {
      "id": "CLIN-32-R1",
      "statement": "A new command `repeat <prescription> <new-prescription>` issues a dispensed prescription again under the new id, for the same patient, drug and dose, and prints `rx2 repeats rx1: amoxicillin 500 mg for p1`. Only a dispensed prescription can be repeated; otherwise it prints `error: rx1 has not been dispensed`. An unknown prescription prints `error: unknown prescription rx9`, and a new id that is already used prints `error: prescription rx2 already exists`.",
      "status": "accepted",
      "owner": "Medical Director",
      "source": {
        "path": "requirements/CLIN-32.md",
        "locator": "## CLIN-32-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
        "sha256": "sha256:36117851f7a0cf24e188b2c3d499794c7f697e45c6cca5f6df08748798943567"
      },
      "supersedes": []
    },
    {
      "id": "CLIN-32-R2",
      "statement": "`help` lists `repeat <prescription> <new-prescription>` directly after `dispense <prescription>`. A repeat joins the queue like any new prescription. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged except as these requirements say; `dotnet test Clinic.slnx` passes.",
      "status": "accepted",
      "owner": "Medical Director",
      "source": {
        "path": "requirements/CLIN-32.md",
        "locator": "## CLIN-32-R2",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
