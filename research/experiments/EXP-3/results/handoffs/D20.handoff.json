    {
      "id": "CLIN-41-R1",
      "statement": "A new command `next-free <clinician> <time>` finds the first day, from tomorrow, on which the clinician has no appointment at that time and an appointment can be booked under the booking-horizon decision in force, and prints `k1 free at 09:00 on 2026-03-03`. If there is no such day it prints `k1 has no free day at 09:00`. It books nothing. An unknown clinician prints `error: unknown clinician k9`.",
      "status": "accepted",
      "owner": "Clinical Operations",
      "source": {
        "path": "requirements/CLIN-41.md",
        "locator": "## CLIN-41-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
