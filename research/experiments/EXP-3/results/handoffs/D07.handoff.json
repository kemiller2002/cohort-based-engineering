  "requirements": [
    {
      "id": "BILL-14-R1",
      "statement": "A new command `credit <customer> <amount>` issues a credit note to a customer. The credit reduces what the customer owes, and the command prints the new balance: `c1 credited 20.00, balance 80.00`. An unknown customer prints `error: unknown customer c9`; an amount that is not a positive amount of money prints `error: invalid amount x`.",
      "status": "accepted",
      "owner": "Finance",
      "source": {
        "path": "requirements/BILL-14.md",
        "locator": "## BILL-14-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
        "sha256": "sha256:9c7e624d968ebb18ee377e8a707c522a54900b2270fcf2713ac0e95572ed1526"
      },
      "supersedes": []
    },
    {
      "id": "BILL-14-R2",
      "statement": "`help` lists `credit <customer> <amount>` directly after `balance <customer>`. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged; `dotnet test Billing.slnx` passes.",
      "status": "accepted",
      "owner": "Finance",
