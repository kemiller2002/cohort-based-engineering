  "requirements": [
    {
      "id": "BILL-31-R1",
      "statement": "A new command `fee-preview <invoice>` shows the late fee the invoice is charged if it is overdue, as the late-fee decision in force sets it, and whether it is overdue now: `i1 late fee 2.25 (overdue)` or `i1 late fee 2.25 (not yet due)`. It charges nothing. An unknown invoice prints `error: unknown invoice i9`.",
      "status": "accepted",
      "owner": "Finance",
      "source": {
        "path": "requirements/BILL-31.md",
        "locator": "## BILL-31-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
