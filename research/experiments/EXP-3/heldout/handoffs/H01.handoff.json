  "requirements": [
    {
      "id": "CLM-07-R1",
      "statement": "Each claim is routed on intake. A claim whose reported amount is within the fast-track limit in force is settled from the documents the claimant sends, without an adjuster visit. Every other claim is assigned an adjuster.",
      "status": "accepted",
      "owner": "Claims Operations",
      "source": {
        "path": "requirements/CLM-07.md",
        "locator": "## CLM-07-R1",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
        "sha256": "sha256:815b87ec8a2fecee7fc002566c484db776921088e51162462a761d213a0fc8ca"
      },
      "supersedes": []
    },
    {
      "id": "CLM-07-R2",
      "statement": "Each new claim opens with the initial reserve for its peril, under the reserving decision in force. The intake summary shows the total reserved across the day's new claims.",
      "status": "accepted",
      "owner": "Claims Operations",
      "source": {
        "path": "requirements/CLM-07.md",
        "locator": "## CLM-07-R2",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
        "sha256": "sha256:815b87ec8a2fecee7fc002566c484db776921088e51162462a761d213a0fc8ca"
      },
      "supersedes": []
    },
    {
      "id": "CLM-07-R3",
      "statement": "The amount payable on a claim is the reported amount less the policy deductible, never below zero, held to the cent. Acceptance criteria: each statement above holds; existing behaviour is unchanged except as these requirements say.",
      "status": "accepted",
      "owner": "Claims Operations",
      "source": {
        "path": "requirements/CLM-07.md",
        "locator": "## CLM-07-R3",
        "revision": "ea36618648f8a329021ed4c27dd5a6053d6bbb12",
