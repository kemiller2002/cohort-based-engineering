    "decisions": [
      {
        "id": "U3-D1",
        "statement": "Closed accounts are remembered in a new LedgerState field ClosedAccounts: Set\u003CAccountId\u003E; Ledger.empty starts it empty. closeAccount moves the id from Accounts to ClosedAccounts, so the two sets never overlap. Accounts keeps its meaning (the open accounts), so every existing check on Accounts (balance, credit, debit, transfer, closePeriod) treats a closed account as unknown with no further change. Adding a record field is source-breaking only for code that builds LedgerState with a record literal; in this repository only Ledger.empty does.",
        "basis": "evidence",
        "layer1": "evidence-valid",
