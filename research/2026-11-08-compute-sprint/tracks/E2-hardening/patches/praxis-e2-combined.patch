+namespace Praxis.Tests
+
+open System
+open System.IO
+open Praxis.Application.Work
+open Praxis.Domain.Work
+
+/// EXPERIMENTAL (Echelon sprint 2026-11-08, track E2): regression tests for
+/// E-F-03 (claim-store deletion bypasses the plain-completion guard) and
+/// E-F-11 (hand-edited queue.json completion goes unnoticed).
+[<RequireQualifiedAccess>]
+module E2HardeningTests =
+    let private t name run = { Name = $"E2 hardening: {name}"; Run = run }
+
+    let private identity =
+        [ "PRAXIS_ACTOR_KIND", "agent"; "PRAXIS_ACTOR", "test/e2"; "PRAXIS_TELEMETRY_PROVIDER", "test"; "PRAXIS_TELEMETRY_RUNTIME", "test" ]
+
+    let private claimOf id status : WorkClaim =
+        { WorkItemId = id
+          Revision = 1L
+          Generation = 1L
+          Status = status
+          Holder = None
+          PreviousClaimant = None
+          PendingPacketDigest = None
+          ConsumedPacketDigests = []
+          Completion = None
+          UpdatedAt = DateTimeOffset.UnixEpoch }
+
+    let private refusedWith code outcome =
+        match outcome with
+        | PlainCompletion.Refused finding -> Assert.equal code finding.Code
+        | PlainCompletion.Permitted -> failwith $"expected refusal {code}"
+
+    let private item id status : BacklogQueueItemRecord = { Id = id; Status = status; Priority = None }
+
+    let tests =
+        [ t "tracked history: a claim marker without a verified completion is Claimed" (fun () ->
+              Assert.equal TrackedClaimHistory.Claimed (TrackedClaimHistory.ofEvents "WI-1" [ "work.claim.recorded", "WI-1"; "work.completed", "WI-2" ])
+              Assert.equal TrackedClaimHistory.VerifiedComplete (TrackedClaimHistory.ofEvents "WI-1" [ "work.claim.recorded", "WI-1"; "work.completion.verified", "WI-1" ])
+              Assert.equal TrackedClaimHistory.NeverClaimed (TrackedClaimHistory.ofEvents "WI-1" [ "work.claim.recorded", "WI-2"; "work.started", "WI-1" ]))
+
+          t "E-F-03: a missing store record with a tracked claim is refused with CLAIM_RECORD_MISSING" (fun () ->
+              PlainCompletion.decideWithHistory false "WI-1" None TrackedClaimHistory.Claimed |> refusedWith PlainCompletion.ClaimRecordMissingCode
+              PlainCompletion.decideWithHistory true "WI-1" None TrackedClaimHistory.Claimed |> refusedWith PlainCompletion.ClaimRecordMissingCode)
+
+          t "E-F-03: a store that claims completion without a tracked verified completion is refused" (fun () ->
+              PlainCompletion.decideWithHistory false "WI-1" (Some(claimOf "WI-1" ClaimStatus.Completed)) TrackedClaimHistory.Claimed
+              |> refusedWith PlainCompletion.ClaimRecordMissingCode)
+
+          t "controls: unclaimed and verified-complete items keep the 3.25.0 decisions" (fun () ->
+              Assert.equal PlainCompletion.Permitted (PlainCompletion.decideWithHistory false "WI-1" None TrackedClaimHistory.NeverClaimed)
+              PlainCompletion.decideWithHistory true "WI-1" None TrackedClaimHistory.NeverClaimed |> refusedWith PlainCompletion.RequiredCode
+              Assert.equal PlainCompletion.Permitted (PlainCompletion.decideWithHistory false "WI-1" None TrackedClaimHistory.VerifiedComplete)
+              Assert.equal PlainCompletion.Permitted (PlainCompletion.decideWithHistory false "WI-1" (Some(claimOf "WI-1" ClaimStatus.Completed)) TrackedClaimHistory.VerifiedComplete)
+              PlainCompletion.decideWithHistory false "WI-1" (Some(claimOf "WI-1" ClaimStatus.Claimed)) TrackedClaimHistory.Claimed |> refusedWith PlainCompletion.RequiredCode)
+
+          t "E-F-11: a complete row without a completion event is reported; recorded and non-terminal rows are not" (fun () ->
+              let finding =
+                  Assert.single (BacklogQueueValidation.eventDisagreements [ item "WI-1" "complete"; item "WI-2" "complete"; item "WI-3" "captured" ] (set [ "WI-2" ]))
+
+              Assert.equal BacklogQueueValidation.eventAgreementField finding.Field
+              Assert.isTrue (finding.Message.StartsWith BacklogQueueValidation.UnrecordedCompletionCode) finding.Message
+              Assert.isTrue (finding.Message.Contains "'WI-1'") finding.Message)
+
+          t "cli E-F-03: deleting the claim directory no longer re-enables plain work complete" (fun () ->
+              let root = CliHarness.temporaryDirectory "praxis-e2-claim"
+              CliHarness.git root [ "init"; "-q"; "-b"; "main" ] |> ignore
+              CliHarness.write root ".ros/work/queue.json" """{"schemaVersion":"1.0.0","items":[{"id":"E2-CLAIM-1","status":"captured"}]}"""
+              CliHarness.commitAll root "fixture"
+              Assert.equal 0 (CliHarness.rosWith root identity [ "work"; "claim"; "--id"; "E2-CLAIM-1"; "--token"; "tok-e2" ]).Exit
+              Assert.isTrue (CliHarness.read root ".ros/events/events.jsonl" |> fun text -> text.Contains "work.claim.recorded" && not (text.Contains "tok-e2")) "claim leaves a token-free tracked marker"
+              Directory.Delete(Path.Combine(root, ".git", "praxis", "claims", "E2-CLAIM-1"), true)
+              let refused = CliHarness.rosWith root identity [ "work"; "complete"; "--id"; "E2-CLAIM-1"; "--occurred-at"; "2026-11-08T12:00:00.000Z" ]
+              Assert.equal 3 refused.Exit
+              Assert.isTrue (refused.Err.Contains PlainCompletion.ClaimRecordMissingCode) refused.Err)
+
+          t "cli E-F-11: work validate reports a hand-edited complete row" (fun () ->
+              let root = CliHarness.initializedRepository "praxis-e2-queue" None
+              CliHarness.rosOk root [ "work"; "capture"; "--title"; "t"; "--id"; "E2-QUEUE-1"; "--occurred-at"; CliHarness.now () ] |> ignore
+              let queue = CliHarness.read root ".ros/work/queue.json"
+              Assert.equal 0 (CliHarness.ros root [ "work"; "validate" ]).Exit
+              CliHarness.write root ".ros/work/queue.json" (queue.Replace("\"status\": \"captured\"", "\"status\": \"complete\"").Replace("\"status\":\"captured\"", "\"status\":\"complete\""))
+              let result = CliHarness.ros root [ "work"; "validate" ]
+              Assert.equal 1 result.Exit
+              Assert.isTrue (result.Out.Contains BacklogQueueValidation.UnrecordedCompletionCode) result.Out)
+
+          t "E-F-01: evidence outside the repository root is refused unless explicitly allowed" (fun () ->
+              let evidence path : WorkEvidence = { Type = "tests"; Path = path }
+              Assert.isTrue (EvidencePathPolicy.contains '/' "/repo" "/repo/logs/t.log") "inside"
+              Assert.isTrue (not (EvidencePathPolicy.contains '/' "/repo" "/repository/t.log")) "a sibling with a shared prefix is outside"
+              let refusal = Assert.single (EvidencePathPolicy.refusals '/' false "/repo" [ evidence "/etc/hostname", "/etc/hostname"; evidence "logs/t.log", "/repo/logs/t.log" ])
+              Assert.isTrue (refusal.StartsWith EvidencePathPolicy.OutsideRepositoryCode) refusal
+              Assert.empty (EvidencePathPolicy.refusals '/' true "/repo" [ evidence "/etc/hostname", "/etc/hostname" ]))
+
+          t "cli E-F-01: work complete refuses /etc/hostname and a symlink to it, and binds an in-repo log" (fun () ->
+              let root = CliHarness.initializedRepository "praxis-e2-evidence" None
+              CliHarness.write root "README.md" "# fixture\n"
+              CliHarness.write root "run.log" "1 test passed\n"
+              File.CreateSymbolicLink(Path.Combine(root, "link.log"), "/etc/hostname") |> ignore
+              CliHarness.commitAll root "logs"
+              for id in [ "E2-EV-1"; "E2-EV-2"; "E2-EV-3" ] do
+                  CliHarness.rosOk root [ "work"; "capture"; "--title"; "t"; "--id"; id; "--occurred-at"; CliHarness.now () ] |> ignore
+                  CliHarness.rosOk root [ "work"; "backlog-transition"; "--id"; id; "--action"; "ready"; "--occurred-at"; CliHarness.now () ] |> ignore
+                  CliHarness.rosOk root [ "work"; "start"; "--id"; id; "--occurred-at"; CliHarness.now () ] |> ignore
+              let complete id path = CliHarness.ros root [ "work"; "complete"; "--id"; id; "--occurred-at"; CliHarness.now (); "--evidence"; "implementation=README.md"; "--evidence"; $"tests={path}" ]
+              for id, path in [ "E2-EV-1", "/etc/hostname"; "E2-EV-2", "link.log" ] do
+                  let refused = complete id path
+                  Assert.equal 1 refused.Exit
+                  Assert.isTrue (refused.Err.Contains EvidencePathPolicy.OutsideRepositoryCode) refused.Err
+              let accepted = complete "E2-EV-3" "run.log"
+              Assert.equal 0 accepted.Exit
+              let bindings = CliHarness.read root ".ros/work/evidence-bindings.jsonl"
+              let digest = "sha256:" + Convert.ToHexString(Security.Cryptography.SHA256.HashData(File.ReadAllBytes(Path.Combine(root, "run.log")))).ToLowerInvariant()
+              let head = CliHarness.git root [ "rev-parse"; "HEAD" ]
+              Assert.isTrue (bindings.Contains digest && bindings.Contains head && bindings.Contains "\"committedAtHead\":true") bindings
+              let validation = CliHarness.ros root [ "work"; "validate" ]
+              Assert.equal 0 validation.Exit) ]
