                "quote": "let allocate (fines: Fine list) (paid: decimal) : (Fine * decimal) list ="
              },
              {
                "file": "src/Lending.Application/Views.fs",
                "line": 270,
                "quote": "if paid >= fine.Amount then \"paid\" elif paid = 0m then \"unpaid\""
              },
