      },
      "supersedes": []
    },
    {
      "id": "BILL-31-R2",
      "statement": "`help` lists `fee-preview <invoice>` directly after `run-late-fees`. Acceptance criteria: each statement above holds; the standing requirements in `README.md` hold; existing behaviour is unchanged except as these requirements say; `dotnet test Billing.slnx` passes.",
      "status": "accepted",
