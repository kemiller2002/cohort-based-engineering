      },
      "supersedes": []
    },
    {
      "id": "CLM-12-R3",
      "statement": "A claim reported after the reporting window has closed is declined as a late report. Acceptance criteria: each statement above holds; existing behaviour is unchanged except as these requirements say.",
      "status": "accepted",
      "owner": "Claims Operations; Special Investigations",
      "source": {
