      },
      "supersedes": []
    },
    {
      "id": "CLIN-21-R2",
      "statement": "`queue` lists urgent prescriptions first, then the others; within each group, prescriptions are listed in the order they were written. Urgent prescriptions are marked: `queue: rx2 (urgent, unchecked), rx1 (unchecked)`.",
      "status": "accepted",
      "owner": "Urgent Care",
      "source": {
